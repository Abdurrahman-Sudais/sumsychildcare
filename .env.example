# =============================================
# Sumsy-Childcare Environment Variables
# Copy this file to .env.local and fill in values
# =============================================

# Site URL (used for SEO / OG metadata)
NEXT_PUBLIC_SITE_URL=https://www.sumsychildcare.com

# WhatsApp Business number (digits only, with country code)
NEXT_PUBLIC_WHATSAPP_NUMBER=447448364115

# Contact email (used in footer and contact page)
NEXT_PUBLIC_CONTACT_EMAIL=sumsychildcareltd@myyahoo.com

# Google Maps Embed API key (optional — for Maps embed)
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# Form submission endpoint (optional — connect to Resend / Formspree / other service)
# FORM_SUBMISSION_API_KEY=your_api_key_here
# FORM_SUBMISSION_ENDPOINT=https://formspree.io/f/your-form-id
